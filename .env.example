# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy Supabase projects may use this instead of the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: enables AI parsing in the Quick-Drop command bar.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Reserved for future server-side Google OAuth flows. The current calendar
# connection uses the Google provider token returned by Supabase Auth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
